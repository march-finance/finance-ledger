-- LedgerValidation — Accounting validation against a fixed account chart without modifying
-- journal history. Per-asset debit/credit conservation is checked exactly. Validation
-- neither reserves replay keys nor provides authorization.
--
-- Usage and tested examples: docs/guide.md and test/docs_quickstart_test.march.

mod LedgerValidation do
  -- Opaque immutable draft that passed chart validation. Not bound to a journal identity or
  -- replay state; post_validated rechecks its destination.
  opaque type Validated = ValidatedValue(LedgerEntry.Draft)

  doc """
  Validate d against accounts and return Validated. DuplicateAccount for duplicate chart
  IDs; EmptyEntry for fewer than two postings; UnknownAccount or AssetMismatch for invalid
  destinations; Unbalanced when any asset's signed atom total is nonzero. Does not reserve
  or check replay IDs.
  """
  fn validate(accounts : List(LedgerAccount.Account), d : LedgerEntry.Draft) : Result(Validated, LedgerError.Error) do
    let ps = LedgerEntry.postings(d)
    if !LedgerAccount.unique_ids(accounts) do Err(LedgerError.DuplicateAccount)
    else if List.length(ps) < 2 do Err(LedgerError.EmptyEntry) else
      let? _ = Result.collect(List.map(ps, fn p ->
        match List.find(accounts, fn a -> LedgerAccount.id(a) == LedgerEntry.account(p)) do
          None -> Err(LedgerError.UnknownAccount)
          Some(a) ->
            if LedgerAccount.same_asset(LedgerAccount.asset(a), FinanceAmount.quantity_asset(LedgerEntry.quantity(p))) do Ok(())
            else Err(LedgerError.AssetMismatch) end
        end))
      let balanced = List.all(ps, fn p ->
        let asset = FinanceAmount.quantity_asset(LedgerEntry.quantity(p))
        let total = List.fold_left(ps, BigInt.zero(), fn (total, q) ->
          if LedgerAccount.same_asset(asset, FinanceAmount.quantity_asset(LedgerEntry.quantity(q))) do
            BigInt.add(total, LedgerEntry.signed_atoms(q))
          else total end)
        BigInt.is_zero(total))
      if balanced do Ok(ValidatedValue(d)) else Err(LedgerError.Unbalanced) end
    end end
  end

  doc """
  Return the immutable draft inside v. Infallible; deriving an edited draft does not
  change v and the edited value must be validated again.
  """
  fn draft(v : Validated) : LedgerEntry.Draft do
    match v do ValidatedValue(d) -> d end
  end
end
